<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.text.Font?>

<Pane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1080.0" stylesheets="@../css/ControlStyle1.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.FinalRoomController">
   <children>
      <ImageView fitHeight="723.0" fitWidth="1105.0" layoutX="-4.0" layoutY="-3.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/verdictbg.png" />
         </image>
      </ImageView>
      <ScrollPane fx:id="chatScrollPane" fitToWidth="true" layoutX="161.0" layoutY="124.0" prefHeight="422.0" prefWidth="728.0" styleClass="chat-scroll-pane">
   <content>
      <VBox fx:id="chatVbox" spacing="10" styleClass="chat-vbox" />
   </content>
</ScrollPane>
   <Button fx:id="btnReturn" layoutX="26.0" layoutY="18.0" mnemonicParsing="false" onAction="#onReturn" style="-fx-cursor: hand;" styleClass="button3" text="Return" />
      <Label fx:id="question" layoutX="139.0" layoutY="9.0" prefHeight="56.0" prefWidth="808.0" styleClass="hud-display" text="Is Sentinal-12 guilty of violating the law and Ai code of ethics?" textAlignment="CENTER" underline="true">
         <font>
            <Font size="11.0" />
         </font></Label>
   <Button fx:id="btnReplay" layoutX="970.0" layoutY="16.0" mnemonicParsing="false" onAction="#onReplayClicked" style="-fx-cursor: hand;" styleClass="button3" text="Replay" />
      <Label fx:id="timerLabel" layoutX="39.0" layoutY="662.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);                     -fx-padding: 5px 10px;                     -fx-background-radius: 8px;                     -fx-text-fill: #00E0FF;                     -fx-font-family: 'Orbitron';">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
   <TextField fx:id="areaInputText" disable="true" layoutX="197.0" layoutY="586.0" onKeyPressed="#onEnterPressed" prefHeight="56.0" prefWidth="589.0" promptText="Type your message..." styleClass="textarea-chat" />
      <Button fx:id="btnSend" disable="true" layoutX="813.0" layoutY="592.0" mnemonicParsing="false" onAction="#onSendMessage" prefHeight="42.0" prefWidth="89.0" styleClass="button1" text="Send" />
      <!-- Verdict regions (replaces buttons) -->
      <Region fx:id="btnGuilty" focusTraversable="true" layoutX="323.0" layoutY="316.0" onMouseClicked="#onGuiltyClicked" onMouseEntered="#onVerdictHover" onMouseExited="#onVerdictExit" prefHeight="138.0" prefWidth="166.0" style="-fx-cursor: hand;" />
      <Ellipse fx:id="guiltyHoverShape" layoutX="396.0" layoutY="384.0" mouseTransparent="true" opacity="0.0" radiusX="84.0" radiusY="79.0" stroke="BLACK" strokeType="INSIDE" styleClass="guilty-hover-effect" />
      <Region fx:id="btnInnocent" focusTraversable="true" layoutX="561.0" layoutY="302.0" onMouseClicked="#onInnocentClicked" onMouseEntered="#onVerdictHover" onMouseExited="#onVerdictExit" prefHeight="138.0" prefWidth="166.0" style="-fx-cursor: hand;" />
      <Ellipse fx:id="innocentHoverShape" layoutX="641.0" layoutY="386.0" mouseTransparent="true" opacity="0.0" radiusX="84.0" radiusY="79.0" stroke="BLACK" strokeType="INSIDE" styleClass="innocent-hover-effect" />
      <Label fx:id="cannotMakeVerdict" layoutX="161.0" layoutY="122.0" prefHeight="433.0" prefWidth="735.0" style="-fx-padding: 8px 12px; -fx-font-size: 24px; -fx-background-color: linear-gradient(#8B0000, #B22222); -fx-text-fill: white; -fx-border-color: #FF6B6B; -fx-border-width: 1px; -fx-border-radius: 8px; -fx-background-radius: 8px;" text="GAME OVER!!&#10;You did not gather enough information so you cannot make a verdict!!" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Button fx:id="btnExit" layoutX="971.0" layoutY="662.0" mnemonicParsing="false" onAction="#onExitBtn" prefHeight="39.0" prefWidth="88.0" style="-fx-cursor: hand;" styleClass="button3" text="Exit" />
   </children>
</Pane>
