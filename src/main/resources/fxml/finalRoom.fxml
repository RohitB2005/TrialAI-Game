<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="800.0" stylesheets="@../css/ControlStyle1.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.FinalRoomController">
   <children>
      <ImageView fitHeight="564.0" fitWidth="434.0" layoutX="188.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/Sentinal-12.png" />
