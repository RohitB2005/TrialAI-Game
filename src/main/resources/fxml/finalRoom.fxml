      </ImageView>
      <Button fx:id="btnGuilty" layoutX="73.0" layoutY="582.0" mnemonicParsing="false" onAction="#onGuiltyButton" prefHeight="30.0" prefWidth="85.0" styleClass="button2" text="Guilty" />
      <Button fx:id="btnInnocent" layoutX="642.0" layoutY="582.0" mnemonicParsing="false" onAction="#onInnocentButton" prefHeight="30.0" prefWidth="85.0" styleClass="button1" text="Not-Guilty" />
