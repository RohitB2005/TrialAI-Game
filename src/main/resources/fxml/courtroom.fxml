      <Region fx:id="witnessAi" layoutX="823.0" layoutY="320.0" onMouseClicked="#handleRegionClicked" onMouseEntered="#onCharacterHover" onMouseExited="#onCharacterExit" prefHeight="240.0" prefWidth="191.0">
