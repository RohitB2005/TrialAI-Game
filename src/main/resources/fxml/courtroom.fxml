      <Region fx:id="witnessHuman" layoutX="30.0" layoutY="277.0" onMouseClicked="#handleRegionClicked" onMouseEntered="#onCharacterHover" onMouseExited="#onCharacterExit" prefHeight="323.0" prefWidth="198.0">
