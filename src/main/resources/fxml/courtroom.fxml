            <Cursor fx:constant="HAND" />
         </cursor></Region>
      <Region fx:id="trialAi" layoutX="269.0" layoutY="113.0" onMouseClicked="#handleRegionClicked" onMouseEntered="#onCharacterHover" onMouseExited="#onCharacterExit" prefHeight="479.0" prefWidth="317.0">
